# Copy to .env.local (git-ignored). No backend ships with this repo.
# Base URL of an AyuUnity-compatible API (expects /health, /auth/otp/*, /auth/session, /auth/signup/*, /files).
VITE_API_BASE_URL=http://localhost:5000
# Force the built-in mock API (always on in `npm run dev`).
VITE_USE_MOCKS=true
# Status returned for professional logins in mock mode: pending | active | denied
VITE_DEMO_PRO_STATUS=pending
